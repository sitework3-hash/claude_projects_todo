{
  "name": "todo-learn",
  "version": "0.1.0",
  "private": true,
  "description": "Expense tracker monorepo (Next.js + Nest.js + Prisma)",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web",
    "dev:web": "npm run dev -w frontend",
    "dev:api": "npm run start:dev -w backend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run generate -w @todo-learn/database",
    "db:migrate": "npm run migrate -w @todo-learn/database",
    "db:studio": "npm run studio -w @todo-learn/database"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
