# --- PostgreSQL (используется docker-compose и Prisma) ---
POSTGRES_USER=todo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=todo_learn
POSTGRES_PORT=5432

# --- Prisma / backend ---
DATABASE_URL=postgresql://todo:changeme@localhost:5432/todo_learn?schema=public

# --- Backend (Nest.js) ---
PORT=3001
JWT_SECRET=change-me-dev-secret
JWT_EXPIRES_IN=1d

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
