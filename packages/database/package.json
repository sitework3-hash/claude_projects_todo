{
  "name": "@todo-learn/database",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "types": "index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "set -a; [ -f ../../.env ] && . ../../.env; set +a; prisma migrate dev",
    "migrate:deploy": "set -a; [ -f ../../.env ] && . ../../.env; set +a; prisma migrate deploy",
    "migrate:status": "set -a; [ -f ../../.env ] && . ../../.env; set +a; prisma migrate status",
    "studio": "set -a; [ -f ../../.env ] && . ../../.env; set +a; prisma studio",
    "format": "prisma format"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "prisma": "^6.2.1"
  }
}
